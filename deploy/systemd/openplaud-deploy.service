# Checks origin/main and rebuilds when it moved. Installed on the VM:
#
#   sudo cp /opt/openplaud/deploy/systemd/openplaud-deploy.* /etc/systemd/system/
#   sudo sed -i 's/^User=CHANGE_ME/User=YOUR_USER/' /etc/systemd/system/openplaud-deploy.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openplaud-deploy.timer
#
# See docs/DEPLOYMENT.md for the full walkthrough.

[Unit]
Description=Deploy OpenPlaud from origin/main
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# Must be the user that owns /opt/openplaud and is in the docker group, so the
# checkout keeps its ownership and `docker compose` works without sudo.
User=CHANGE_ME

WorkingDirectory=/opt/openplaud

# The deploy resets the checkout, which rewrites scripts/deploy.sh underneath a
# running bash. Run it from a copy outside the checkout instead. systemd creates
# /run/openplaud-deploy owned by User= for us; writing straight into /run fails,
# because that is root's.
RuntimeDirectory=openplaud-deploy
ExecStartPre=/usr/bin/install -m 0755 /opt/openplaud/scripts/deploy.sh /run/openplaud-deploy/deploy.sh
ExecStart=/run/openplaud-deploy/deploy.sh

# A rebuild takes minutes; do not let systemd kill it halfway.
TimeoutStartSec=1800
